# ============================================================
# TaskView (local) - se usa con compose.local.yml
# Copiar a .env:  cp .env.local.example .env
# ============================================================

TASKVIEW_VERSION=1.56.0
CENTRIFUGO_VERSION=v6.9.7


# ------------------------------------------------
# Database (PostgreSQL de local-infra-dev)
# ------------------------------------------------

DB_HOST=local_postgres
DB_PORT=5432
DB_NAME=taskview_local
DB_USER=taskview
DB_PASSWORD=cambia-esta-clave

# PM2_INSTANCES x DB_POOL_MAX debe quedar por debajo de max_connections (100),
# que comparten todos los proyectos de local-infra.
PM2_INSTANCES=2
DB_POOL_MAX=10

# Usuario administrador del PostgreSQL local (solo lo usa db-init).
# Debe coincidir con local-infra-dev/.env
DB_ADMIN_DATABASE=postgres
DB_ADMIN_USER=tu_usuario
DB_ADMIN_PASSWORD=tu_password


# ------------------------------------------------
# Application
# ------------------------------------------------

APP_PORT=1401

# --- Opcion A: solo localhost (sin tunel) ---
APP_URL=http://localhost:8888
API_PUBLIC_URL=http://localhost:1725
CENTRIFUGO_PUBLIC_URL=ws://localhost:8000/connection/websocket
TRUST_PROXY=

# --- Opcion B: tunel Cloudflare local (requerido por Slack, Telegram y
# webhooks de GitHub/GitLab/Gitea). Descomentar y comentar la opcion A.
# Levantar con: docker compose -f compose.local.yml --profile tunnel up -d
# APP_URL=https://tasks-local.slasdevelopments.com
# API_PUBLIC_URL=https://tasks-api-local.slasdevelopments.com
# CENTRIFUGO_PUBLIC_URL=wss://tasks-ws-local.slasdevelopments.com/connection/websocket
# TRUST_PROXY=1

LOCAL_CLOUDFLARE_TUNNEL_TOKEN=

# Lo usa el contenedor taskview-webapp (oculta el selector de servidor).
TASKVIEW_API_URL=${API_PUBLIC_URL}

CORS_ALLOWED_ORIGINS=http://localhost:8888,http://127.0.0.1:8888,https://tasks-local.slasdevelopments.com

LOG_LEVEL=info


# ------------------------------------------------
# Authentication
# ------------------------------------------------

JWT_ALG=HS256
# openssl rand -hex 64
JWT_SIGN=cambia-esta-clave
ACCESS_LIFE_TIME=3d
REFRESH_LIFE_TIME=9d

AUTH_LOGIN_METHODS=password,magic-link,social
ALLOW_PUBLIC_REGISTRATION=false
# "email" requiere SMTP; "password" confirma con la clave actual.
PASSWORD_CHANGE_CONFIRMATION=password

# Permite que claude.ai / ChatGPT se registren via OAuth en el MCP.
# En local se usa token tvk_ y no hace falta.
OAUTH_DYNAMIC_REGISTRATION=false

# Permite webhooks hacia n8n local (http://local_n8n:5678/webhook/...).
WEBHOOKS_ALLOW_PRIVATE_URLS=true


# ------------------------------------------------
# Encryption (SSO e integraciones GitHub/GitLab)
# ------------------------------------------------

# openssl rand -hex 32  (64 caracteres hex). No cambiarla despues.
ENCRYPTION_KEY=cambia-esta-clave


# ------------------------------------------------
# SMTP
# ------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_NAME=TaskView
SMTP_FROM_EMAIL=

# Enviar correo al invitar a alguien a un proyecto (requiere SMTP).
INVITE_EMAIL_ENABLED=false


# ------------------------------------------------
# Centrifugo (notificaciones en tiempo real)
# ------------------------------------------------

CENTRIFUGO_API_URL=http://centrifugo:8000
# openssl rand -hex 32
CENTRIFUGO_API_KEY=cambia-esta-clave
# openssl rand -hex 32
CENTRIFUGO_TOKEN_SECRET=cambia-esta-clave


# ------------------------------------------------
# Files (adjuntos)
# ------------------------------------------------

FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_DIR=/usr/src/app/data/files
FILE_MAX_SIZE_MB=10
FILE_QUOTA_MODE=off


# ============================================================
# INTEGRACIONES
# Las URLs de callback se derivan de API_PUBLIC_URL.
# Un ID/secret vacio = esa integracion queda oculta en la UI.
# Guia paso a paso: docs/integraciones.md
# ============================================================

# ------------------------------------------------
# Login social (botones en la pantalla de login)
# ------------------------------------------------

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=${API_PUBLIC_URL}/module/auth/provider/google/callback

# GitHub -> Settings -> Developer settings -> OAuth Apps (app "TaskView Login", scope user:email)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=${API_PUBLIC_URL}/module/auth/provider/github/callback

# Apple Developer -> Sign in with Apple. La llave .p8 va en ./secrets/AuthKey.p8
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_KEY_LOCATION=/usr/src/app/secrets/AuthKey.p8
APPLE_CALLBACK_URL=${API_PUBLIC_URL}/module/auth/provider/apple/callback


# ------------------------------------------------
# Repositorios (issues -> tareas, sync por webhooks)
# ------------------------------------------------

# GitHub OAuth App distinta a la de login (scope repo)
GITHUB_INTEGRATION_CLIENT_ID=
GITHUB_INTEGRATION_CLIENT_SECRET=
GITHUB_INTEGRATION_CALLBACK_URL=${API_PUBLIC_URL}/module/integrations/oauth/github/callback
# Solo para GitHub Enterprise:
# GITHUB_BASE_URL=https://github.com
# GITHUB_API_URL=https://api.github.com

# GitLab -> Preferences -> Applications (scope api)
GITLAB_INTEGRATION_CLIENT_ID=
GITLAB_INTEGRATION_CLIENT_SECRET=
GITLAB_INTEGRATION_CALLBACK_URL=${API_PUBLIC_URL}/module/integrations/oauth/gitlab/callback
# Solo para GitLab self-hosted:
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_API_URL=https://gitlab.com/api/v4

# Gitea -> Settings -> Applications -> OAuth2 Applications
GITEA_INTEGRATION_CLIENT_ID=
GITEA_INTEGRATION_CLIENT_SECRET=
GITEA_INTEGRATION_CALLBACK_URL=${API_PUBLIC_URL}/module/integrations/oauth/gitea/callback
# Solo para Gitea self-hosted:
# GITEA_BASE_URL=https://gitea.com


# ------------------------------------------------
# Mensajeria (notificaciones + /task desde el chat)
# ------------------------------------------------

# @BotFather -> /newbot, /setprivacy Disable, /setjoingroups Enable
# Luego registrar el webhook: bash scripts/telegram-webhook.sh
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-me

# api.slack.com/apps -> Create New App (scopes chat:write, commands, chat:write.public, im:write)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_CALLBACK_URL=${API_PUBLIC_URL}/module/messaging/slack/oauth/callback


# ------------------------------------------------
# Push movil (apps iOS / Android)
# ------------------------------------------------

# Firebase -> Project settings -> Service accounts -> Generate new private key
# Guardar el JSON en ./secrets/firebase-credentials.json y descomentar:
# FIREBASE_CREDENTIALS_PATH=/usr/src/app/secrets/firebase-credentials.json


# ------------------------------------------------
# Timezone
# ------------------------------------------------

TZ=America/Caracas
