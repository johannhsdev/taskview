# ============================================================
# TaskView (VPS) - se usa con compose.yml
# Copiar a .env:  cp .env.example .env
# Generar secretos con:  openssl rand -hex 32
# ============================================================

TASKVIEW_VERSION=1.56.0
CENTRIFUGO_VERSION=v6.9.7


# ------------------------------------------------
# Dominios publicos (Cloudflare Tunnel)
# ------------------------------------------------

APP_URL=https://tasks.slasdevelopments.com
API_PUBLIC_URL=https://tasks-api.slasdevelopments.com

# Lo usan taskview-webapp y taskview-mcp.
TASKVIEW_API_URL=${API_PUBLIC_URL}
MCP_PUBLIC_URL=https://tasks-mcp.slasdevelopments.com/mcp

CORS_ALLOWED_ORIGINS=https://tasks.slasdevelopments.com

# Un solo proxy delante (cloudflared).
TRUST_PROXY=1


# ------------------------------------------------
# PostgreSQL (contenedor propio)
# ------------------------------------------------

DB_HOST=postgres
DB_PORT=5432
DB_NAME=taskview
DB_USER=taskview
DB_PASSWORD=change-me

PM2_INSTANCES=2
DB_POOL_MAX=20


# ------------------------------------------------
# Application
# ------------------------------------------------

APP_PORT=1401
LOG_LEVEL=info


# ------------------------------------------------
# Authentication
# ------------------------------------------------

JWT_ALG=HS256
# openssl rand -hex 64
JWT_SIGN=change-me
ACCESS_LIFE_TIME=3d
REFRESH_LIFE_TIME=9d

AUTH_LOGIN_METHODS=password,magic-link,social
ALLOW_PUBLIC_REGISTRATION=false
# "email" requiere SMTP configurado abajo.
PASSWORD_CHANGE_CONFIRMATION=email

# Permite conectar claude.ai / Claude Desktop / ChatGPT al MCP via OAuth.
OAUTH_DYNAMIC_REGISTRATION=true

# n8n se alcanza por su URL publica, no hace falta red privada.
WEBHOOKS_ALLOW_PRIVATE_URLS=false


# ------------------------------------------------
# Encryption (SSO e integraciones GitHub/GitLab)
# ------------------------------------------------

# openssl rand -hex 32  (64 caracteres hex). No cambiarla despues.
ENCRYPTION_KEY=change-me


# ------------------------------------------------
# SMTP
# ------------------------------------------------

SMTP_HOST=change-me
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_ENCRYPTION=tls
SMTP_FROM_NAME=TaskView
SMTP_FROM_EMAIL=change-me

INVITE_EMAIL_ENABLED=true
INVITE_EMAIL_HOURLY_LIMIT=30


# ------------------------------------------------
# Centrifugo (notificaciones en tiempo real)
# ------------------------------------------------

CENTRIFUGO_API_URL=http://centrifugo:8000
CENTRIFUGO_API_KEY=change-me
CENTRIFUGO_TOKEN_SECRET=change-me
CENTRIFUGO_PUBLIC_URL=wss://tasks-ws.slasdevelopments.com/connection/websocket


# ------------------------------------------------
# Files (adjuntos)
# ------------------------------------------------

FILE_STORAGE_PROVIDER=local
FILE_STORAGE_LOCAL_DIR=/usr/src/app/data/files
FILE_MAX_SIZE_MB=10
FILE_QUOTA_MODE=enforce
FILE_QUOTA_ORGANIZATION_MB=1024


# ============================================================
# INTEGRACIONES
# Las URLs de callback se derivan de API_PUBLIC_URL.
# Un ID/secret vacio = esa integracion queda oculta en la UI.
# Guia paso a paso: docs/integraciones.md
# ============================================================

# ------------------------------------------------
# Login social (botones en la pantalla de login)
# ------------------------------------------------

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=${API_PUBLIC_URL}/module/auth/provider/google/callback

# GitHub -> Settings -> Developer settings -> OAuth Apps (app "TaskView Login", scope user:email)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=${API_PUBLIC_URL}/module/auth/provider/github/callback

# Apple Developer -> Sign in with Apple. La llave .p8 va en ./secrets/AuthKey.p8
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_KEY_LOCATION=/usr/src/app/secrets/AuthKey.p8
APPLE_CALLBACK_URL=${API_PUBLIC_URL}/module/auth/provider/apple/callback


# ------------------------------------------------
# Repositorios (issues -> tareas, sync por webhooks)
# ------------------------------------------------

# GitHub OAuth App distinta a la de login (scope repo)
GITHUB_INTEGRATION_CLIENT_ID=
GITHUB_INTEGRATION_CLIENT_SECRET=
GITHUB_INTEGRATION_CALLBACK_URL=${API_PUBLIC_URL}/module/integrations/oauth/github/callback
# Solo para GitHub Enterprise:
# GITHUB_BASE_URL=https://github.com
# GITHUB_API_URL=https://api.github.com

# GitLab -> Preferences -> Applications (scope api)
GITLAB_INTEGRATION_CLIENT_ID=
GITLAB_INTEGRATION_CLIENT_SECRET=
GITLAB_INTEGRATION_CALLBACK_URL=${API_PUBLIC_URL}/module/integrations/oauth/gitlab/callback
# Solo para GitLab self-hosted:
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_API_URL=https://gitlab.com/api/v4

# Gitea -> Settings -> Applications -> OAuth2 Applications
GITEA_INTEGRATION_CLIENT_ID=
GITEA_INTEGRATION_CLIENT_SECRET=
GITEA_INTEGRATION_CALLBACK_URL=${API_PUBLIC_URL}/module/integrations/oauth/gitea/callback
# Solo para Gitea self-hosted:
# GITEA_BASE_URL=https://gitea.com


# ------------------------------------------------
# Mensajeria (notificaciones + /task desde el chat)
# ------------------------------------------------

# @BotFather -> /newbot, /setprivacy Disable, /setjoingroups Enable
# Luego registrar el webhook: bash scripts/telegram-webhook.sh
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=change-me

# api.slack.com/apps -> Create New App (scopes chat:write, commands, chat:write.public, im:write)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_CALLBACK_URL=${API_PUBLIC_URL}/module/messaging/slack/oauth/callback


# ------------------------------------------------
# Push movil (apps iOS / Android)
# ------------------------------------------------

# Firebase -> Project settings -> Service accounts -> Generate new private key
# Guardar el JSON en ./secrets/firebase-credentials.json y descomentar:
# FIREBASE_CREDENTIALS_PATH=/usr/src/app/secrets/firebase-credentials.json


# ------------------------------------------------
# Cloudflare Tunnel
# ------------------------------------------------

CLOUDFLARE_TUNNEL_TOKEN=change-me


# ------------------------------------------------
# Timezone
# ------------------------------------------------

TZ=America/Caracas
